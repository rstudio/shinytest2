linters: linters_with_defaults(
    line_length_linter = NULL,
    indentation_linter = NULL,
    commented_code_linter = NULL,
    return_linter = NULL
  )
exclusions: list(
    "R/cpp11.R",
    "tests/testthat/pkgs/golem/R/run_app.R",
    "vignettes/use-package.Rmd",
    "tests/testthat/pkgs/"
  )
